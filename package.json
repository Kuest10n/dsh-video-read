{
  "name": "dsh-video-read",
  "version": "0.4.1",
  "description": "Give a DSH agent a video link or local file: acquire, sample frames at a chosen fps, read the timeline subtitles, and answer with visual evidence.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/m15-test.mjs",
    "test:self": "node scripts/self-test.mjs",
    "test:client": "node scripts/client-test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "video-understanding",
    "bilibili",
    "ffmpeg",
    "frames"
  ],
  "author": "Kuest10n",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuest10n/dsh-video-read.git"
  },
  "homepage": "https://github.com/Kuest10n/dsh-video-read#readme",
  "bugs": {
    "url": "https://github.com/Kuest10n/dsh-video-read/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
